default_platform(:ios)

platform :ios do
  desc "Build an unsigned IPA for users to sign and install themselves"
  lane :beta do
    build_app(
      project: "Mango.xcodeproj",
      scheme: "Mango",
      configuration: "Release",
      output_directory: "build/ipa",
      derived_data_path: "build/DerivedData",
      buildlog_path: "build/logs",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')} CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      skip_codesigning: true,
      clean: true
    )
  end
end
