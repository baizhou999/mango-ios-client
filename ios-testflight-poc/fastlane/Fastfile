default_platform(:ios)

platform :ios do
  desc "Archive the app and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("build/AuthKey.p8", Dir.pwd)
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, ENV.fetch("ASC_KEY_CONTENT"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )

    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')}",
      "PRODUCT_BUNDLE_IDENTIFIER=#{ENV.fetch('BUNDLE_ID', 'app.mango.im.ios')}",
      "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    ].join(" ")

    build_app(
      project: "Mango.xcodeproj",
      scheme: "Mango",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      derived_data_path: "build/DerivedData",
      buildlog_path: "build/logs",
      xcargs: auth_args,
      export_xcargs: "-allowProvisioningUpdates",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "GitHub Actions build #{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )
  end
end
