default_platform(:ios)

platform :ios do
  desc "Archive the app and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("build/AuthKey.p8", Dir.pwd)
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, ENV.fetch("ASC_KEY_CONTENT"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )

    # 创建 Apple Distribution 证书（development 默认 false）
    cert(
      api_key: api_key,
      platform: "ios",
      team_id: ENV.fetch("TEAM_ID")
    )

    # 创建 App Store provisioning profile，返回 UUID
    profile_uuid = sigh(
      api_key: api_key,
      app_identifier: ENV.fetch("BUNDLE_ID", "app.mango.im.ios"),
      team_id: ENV.fetch("TEAM_ID"),
      adhoc: false
    )

    # 设置 Manual 签名 + 指定 distribution profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Mango.xcodeproj",
      team_id: ENV.fetch("TEAM_ID"),
      bundle_identifier: ENV.fetch("BUNDLE_ID", "app.mango.im.ios"),
      code_sign_identity: "Apple Distribution",
      profile_uuid: profile_uuid
    )

    build_app(
      project: "Mango.xcodeproj",
      scheme: "Mango",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      derived_data_path: "build/DerivedData",
      buildlog_path: "build/logs",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "GitHub Actions build #{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )
  end
end
